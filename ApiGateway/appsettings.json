{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "ordersCluster": {
        "Destinations": {
          "ordersDestination": {
            "Address": "https://localhost:5001"
          }
        }
      }
    },
    "Routes": {
      "ordersRoute": {
        "ClusterId": "ordersCluster",
        "Match": {
          "Path": "/orders/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/orders/{**catch-all}"
          }
        ]
      }
    }
  },
  "AllowedHosts": "*"
}
